{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iMessage Exporter GUI",
  "version": "0.1.0",
  "identifier": "com.reagentx.imessage-exporter-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iMessage Exporter GUI",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/imessage-exporter"
    ],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../SIDE_CAR.md": "SIDE_CAR.md"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  },
  "plugins": {}
}
